# Mag local environment — copy to .env and fill. Never commit .env.
#   Windows: powershell -File scripts\ensure_local_env.ps1
#   Linux:   bash scripts/ensure_local_env.sh
#   Or:      copy .env.example .env  (then edit)

# --- Remote inference (T2) — paste keys here, not in chat or memory/ ---
DEEPSEEK_API_KEY=
DEEPSEEK_OVERMIND_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
TOGETHER_API_KEY=

XAI_API_KEY=
XAI_MODEL=grok-4

# --- Mag distributed surface (home HQ) ---
# Token for tablet/cloud POSTs to :8765 (launch_dashboard_lan.cmd)
MAG_REMOTE_TOKEN=
# Optional: echoed to clients; set on home when using Tailscale/LAN
MAG_PUBLIC_URL=
# Autorun: orchestrator drainer when lab supervisor is up
MAG_DRAINER=0
# DeepSeek prefix cache + tool eco (default on for deepseek)
MAG_BYTE_STABLE_PREFIX=1
MAG_TOOL_ECO=1

# --- vast.ai (GPU rent — not an LLM provider key) ---
VAST_API_KEY=
VAST_OPENAI_BASE_URL=
VAST_OPENAI_API_KEY=
